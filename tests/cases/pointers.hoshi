// expect: 42 43
// expect: 10 20 30
// expect: 2
// expect: swap 2 1
extern fn printf(fmt: *u8, ...) -> i32;

fn swap(a: *i32, b: *i32) {
    let t = *a;
    *a = *b;
    *b = t;
}

fn main() {
    var x = 42;
    let p = &x;
    printf("%d ", *p);
    *p += 1;
    printf("%d\n", x);

    var arr = [10, 20, 30];
    let q: *i32 = &arr[0];
    printf("%d %d %d\n", q[0], *(q + 1), *(q + 3 - 1));
    let end = q + 2;
    printf("%lld\n", end - q);

    var a = 1;
    var b = 2;
    swap(&a, &b);
    printf("swap %d %d\n", a, b);
}
