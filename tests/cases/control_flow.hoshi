// expect: small
// expect: medium
// expect: big
// expect: 0 1 2 4 5
// expect: sum=45
// expect: countdown 3 2 1
// expect: and-or ok
extern fn printf(fmt: *u8, ...) -> i32;

fn classify(n: i32) -> *u8 {
    if n < 10 {
        return "small";
    } else if n < 100 {
        return "medium";
    } else {
        return "big";
    }
}

fn side(flag: *bool) -> bool {
    *flag = true;
    return true;
}

fn main() {
    printf("%s\n", classify(5));
    printf("%s\n", classify(50));
    printf("%s\n", classify(500));

    for i in 0..10 {
        if i == 3 { continue; }
        if i > 5 { break; }
        printf("%d", i);
        if i < 5 { printf(" "); }
    }
    printf("\n");

    var sum = 0;
    var i = 0;
    while i < 10 {
        sum += i;
        i += 1;
    }
    printf("sum=%d\n", sum);

    var k: u32 = 3;
    printf("countdown");
    while true {
        printf(" %u", k);
        k -= 1;
        if k == 0 { break; }
    }
    printf("\n");

    var called = false;
    let r = false && side(&called);
    let s = true || side(&called);
    if !r && s && !called {
        printf("and-or ok\n");
    }
}
