// expect: 3.000000 4.000000 len2=25.000000
// expect: 10 20
// expect: rect 0,0 -> 5,7 area=35
// expect: 4
extern fn printf(fmt: *u8, ...) -> i32;

struct Vec2 { x: f64, y: f64 }

struct Point { x: i32, y: i32 }

struct Rect {
    min: Point,
    max: Point,
}

fn len2(v: Vec2) -> f64 {
    return v.x * v.x + v.y * v.y;
}

fn make_point(x: i32, y: i32) -> Point {
    return Point { x: x, y: y };
}

fn move_by(p: *Point, dx: i32, dy: i32) {
    p.x += dx;
    p.y += dy;
}

fn area(r: *Rect) -> i32 {
    return (r.max.x - r.min.x) * (r.max.y - r.min.y);
}

fn main() {
    let v = Vec2 { x: 3.0, y: 4.0 };
    printf("%f %f len2=%f\n", v.x, v.y, len2(v));

    var p = make_point(1, 2);
    move_by(&p, 9, 18);
    printf("%d %d\n", p.x, p.y);

    var r = Rect { min: Point { x: 0, y: 0 } };
    r.max = make_point(5, 7);
    printf("rect %d,%d -> %d,%d area=%d\n", r.min.x, r.min.y, r.max.x, r.max.y, area(&r));

    printf("%d\n", make_point(4, 5).x);
}
