// expect: 7 -3 10 2 1
// expect: 14 -2 3
// expect: 1 7 7 12 -2
// expect: 255 4294967295
// expect: 2.500000 -1.500000
extern fn printf(fmt: *u8, ...) -> i32;

fn main() {
    let a = 5;
    let b = 2;
    printf("%d %d %d %d %d\n", a + b, b - a, a * b, a / b, a % b);
    printf("%d %d %d\n", (a + b) * 2, -a + 3, 1 + 2 * 3 - 4);
    printf("%d %d %d %d %d\n", a & 3, a | b ^ 1, a ^ b, 3 << 2, -8 >> 2);
    let x: u8 = 255;
    printf("%u %u\n", x, ~0 as u32);
    let f = 5.0 / 2.0;
    let g: f32 = -1.5;
    printf("%f %f\n", f, g);
}
