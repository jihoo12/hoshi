// The n-body benchmark from the Computer Language Benchmarks Game.
extern fn printf(fmt: *u8, ...) -> i32;
extern fn sqrt(x: f64) -> f64;
extern fn atoi(s: *u8) -> i32;

struct Body {
    x: f64, y: f64, z: f64,
    vx: f64, vy: f64, vz: f64,
    mass: f64,
}

fn advance(bodies: *Body, n: i32, dt: f64) {
    for i in 0..n {
        let bi = &bodies[i];
        for j in i + 1..n {
            let bj = &bodies[j];
            let dx = bi.x - bj.x;
            let dy = bi.y - bj.y;
            let dz = bi.z - bj.z;
            let d2 = dx * dx + dy * dy + dz * dz;
            let mag = dt / (d2 * sqrt(d2));
            bi.vx -= dx * bj.mass * mag;
            bi.vy -= dy * bj.mass * mag;
            bi.vz -= dz * bj.mass * mag;
            bj.vx += dx * bi.mass * mag;
            bj.vy += dy * bi.mass * mag;
            bj.vz += dz * bi.mass * mag;
        }
    }
    for i in 0..n {
        let b = &bodies[i];
        b.x += dt * b.vx;
        b.y += dt * b.vy;
        b.z += dt * b.vz;
    }
}

fn energy(bodies: *Body, n: i32) -> f64 {
    var e = 0.0;
    for i in 0..n {
        let b = &bodies[i];
        e += 0.5 * b.mass * (b.vx * b.vx + b.vy * b.vy + b.vz * b.vz);
        for j in i + 1..n {
            let b2 = &bodies[j];
            let dx = b.x - b2.x;
            let dy = b.y - b2.y;
            let dz = b.z - b2.z;
            e -= b.mass * b2.mass / sqrt(dx * dx + dy * dy + dz * dz);
        }
    }
    return e;
}

fn offset_momentum(bodies: *Body, n: i32, solar_mass: f64) {
    var px = 0.0;
    var py = 0.0;
    var pz = 0.0;
    for i in 0..n {
        px += bodies[i].vx * bodies[i].mass;
        py += bodies[i].vy * bodies[i].mass;
        pz += bodies[i].vz * bodies[i].mass;
    }
    bodies[0].vx = -px / solar_mass;
    bodies[0].vy = -py / solar_mass;
    bodies[0].vz = -pz / solar_mass;
}

fn main(argc: i32, argv: **u8) -> i32 {
    let steps = if_arg(argc, argv, 1000);
    let pi = 3.141592653589793;
    let solar_mass = 4.0 * pi * pi;
    let days = 365.24;

    var bodies = [
        Body { x: 0.0, y: 0.0, z: 0.0, vx: 0.0, vy: 0.0, vz: 0.0, mass: solar_mass },
        Body {
            x: 4.84143144246472090e+00, y: -1.16032004402742839e+00, z: -1.03622044471123109e-01,
            vx: 1.66007664274403694e-03 * days, vy: 7.69901118419740425e-03 * days,
            vz: -6.90460016972063023e-05 * days, mass: 9.54791938424326609e-04 * solar_mass,
        },
        Body {
            x: 8.34336671824457987e+00, y: 4.12479856412430479e+00, z: -4.03523417114321381e-01,
            vx: -2.76742510726862411e-03 * days, vy: 4.99852801234917238e-03 * days,
            vz: 2.30417297573763929e-05 * days, mass: 2.85885980666130812e-04 * solar_mass,
        },
        Body {
            x: 1.28943695621391310e+01, y: -1.51111514016986312e+01, z: -2.23307578892655734e-01,
            vx: 2.96460137564761618e-03 * days, vy: 2.37847173959480950e-03 * days,
            vz: -2.96589568540237556e-05 * days, mass: 4.36624404335156298e-05 * solar_mass,
        },
        Body {
            x: 1.53796971148509165e+01, y: -2.59193146099879641e+01, z: 1.79258772950371181e-01,
            vx: 2.68067772490389322e-03 * days, vy: 1.62824170038242295e-03 * days,
            vz: -9.51592254519715870e-05 * days, mass: 5.15138902046611451e-05 * solar_mass,
        },
    ];
    let body_ptr = &bodies[0];
    offset_momentum(body_ptr, 5, solar_mass);
    printf("%.9f\n", energy(body_ptr, 5));
    for s in 0..steps {
        advance(body_ptr, 5, 0.01);
    }
    printf("%.9f\n", energy(body_ptr, 5));
    return 0;
}

fn if_arg(argc: i32, argv: **u8, default: i32) -> i32 {
    if argc > 1 {
        return atoi(argv[1]);
    }
    return default;
}
